{
  "name": "Build HVE Workshop Image",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "SOURCE_REPOSITORY": "${localEnv:GITHUB_REPOSITORY:jmservera/hve-squad-codespace}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26.13.0"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {
      "version": "1.0.105"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "COPILOT_AUTO_UPDATE": "false"
  },
  "postCreateCommand": "bash /usr/local/share/hve/setup-plugins.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "settings": {
        "chat.plugins.enabled": true,
        "chat.pluginLocations": {
          "/opt/hve/marketplace/plugins/hve-squad": true,
          "/opt/hve/marketplace/plugins/hve-squad-hve-core": true
        },
        "chat.plugins.marketplaces": [
          "file:///opt/hve/marketplace"
        ]
      },
      "extensions": [
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-dotnettools.csdevkit",
        "ms-vscode.PowerShell"
      ]
    }
  }
}